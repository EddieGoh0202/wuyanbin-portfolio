{
  "title": "学生反馈洞察工作流",
  "version": "2.1-layout",
  "status": "design-only",
  "notice": "基于原始四分支流程整理的 Coze 风格方案图，非平台截图或可导入配置。",
  "evidence": {
    "feedbackRows": 90,
    "articleCount": 3,
    "reportStatus": "original-v1-example"
  },
  "layout": {
    "direction": "left-to-right",
    "lanes": 4,
    "nodeWidth": 310,
    "nodeHeight": 164
  },
  "nodes": [
    {
      "id": "01",
      "title": "开始",
      "type": "开始",
      "x": 40,
      "y": 470,
      "input": "comments · contents",
      "output": "问卷链接 · 文章材料",
      "config": "对应原图两个输入",
      "description": "接收问卷 comments 与公众号材料 contents，保持原工作流的双输入。"
    },
    {
      "id": "02",
      "title": "读取问卷表格",
      "type": "插件",
      "x": 440,
      "y": 450,
      "input": "comments",
      "output": "records[]",
      "config": "原 read 节点",
      "description": "读取序号、反馈时间、用户反馈内容，保留行号作为来源 ID。"
    },
    {
      "id": "03",
      "title": "反馈清洗与脱敏",
      "type": "代码",
      "x": 840,
      "y": 450,
      "input": "records[]",
      "output": "cleaned[] · totals",
      "config": "空值处理 / 个人信息脱敏",
      "description": "统一空白和时间格式，隐藏电话、邮箱；空反馈不参与分析，相同文本保留各自记录和频次，并说明清洗前后数量。"
    },
    {
      "id": "04",
      "title": "分词与词频统计",
      "type": "代码",
      "x": 1260,
      "y": 170,
      "input": "cleaned[].text",
      "output": "frequencies[]",
      "config": "分词 / 停用词过滤",
      "description": "按统一规则对词语计数，保留频次，不凭空生成统计值。"
    },
    {
      "id": "05",
      "title": "高频词整理",
      "type": "大模型",
      "x": 1660,
      "y": 170,
      "input": "frequencies[]",
      "output": "wordcloud_input",
      "config": "同义词归并 / 保留频次",
      "description": "整理高频词表达，同义词合并时累计原计数，形成词云插件输入。"
    },
    {
      "id": "06",
      "title": "WordCloud_generation",
      "type": "插件",
      "x": 2060,
      "y": 170,
      "input": "wordcloud_input",
      "output": "img_markdown",
      "config": "沿用原词云生成支路",
      "description": "输出可嵌入报告的词云图片。"
    },
    {
      "id": "07",
      "title": "评论情感分析",
      "type": "大模型",
      "x": 1260,
      "y": 450,
      "input": "cleaned[]",
      "output": "sentiment_rows[]",
      "config": "积极 / 中性 / 消极",
      "description": "逐条判断情绪并保留来源 ID；语义不足的内容归为未分类。"
    },
    {
      "id": "08",
      "title": "情绪分布统计",
      "type": "代码",
      "x": 1660,
      "y": 450,
      "input": "sentiment_rows[]",
      "output": "chart_data · totals",
      "config": "计数 / 比例 / 未分类说明",
      "description": "按有效反馈记录计数，给出分母；未分类单列，避免丢失总数。"
    },
    {
      "id": "09",
      "title": "生成情感分析饼图",
      "type": "插件",
      "x": 2060,
      "y": 450,
      "input": "chart_data",
      "output": "emotion_chart",
      "config": "沿用原图表支路",
      "description": "根据统计值生成图表，显示数量、比例和未分类说明。"
    },
    {
      "id": "10",
      "title": "问题主题归类",
      "type": "大模型",
      "x": 1260,
      "y": 730,
      "input": "cleaned[]",
      "output": "topic_rows[]",
      "config": "主题 / 诉求 / 原话 ID",
      "description": "提取反馈中的问题和诉求，保留原话 ID，不把公众号材料混作反馈。"
    },
    {
      "id": "11",
      "title": "高频问题聚合",
      "type": "代码",
      "x": 1660,
      "y": 730,
      "input": "topic_rows[]",
      "output": "issues[] · evidence",
      "config": "同类合并 / 条数排序",
      "description": "按主题聚合并统计关联反馈数量，保留代表原话；多标签统计需明确口径。"
    },
    {
      "id": "12",
      "title": "问题报告与建议",
      "type": "大模型",
      "x": 2060,
      "y": 730,
      "input": "issues[] · evidence",
      "output": "issue_report",
      "config": "主要问题 / 依据 / 建议",
      "description": "延续原问题报告节点，整理问题、原话依据和可执行建议，不虚构处理效果。"
    },
    {
      "id": "13",
      "title": "读取公众号材料",
      "type": "插件",
      "x": 440,
      "y": 1020,
      "input": "contents",
      "output": "articles[]",
      "config": "原 read_1 节点",
      "description": "读取原有公众号材料，作为独立校园动态来源。"
    },
    {
      "id": "14",
      "title": "校园事件提取",
      "type": "大模型",
      "x": 840,
      "y": 1020,
      "input": "articles[]",
      "output": "events[] · sources",
      "config": "时间 / 事件 / 来源",
      "description": "提取事件、时间和来源；缺失信息留空，不补造事实。"
    },
    {
      "id": "15",
      "title": "每周事件总结",
      "type": "大模型",
      "x": 1260,
      "y": 1020,
      "input": "events[] · sources",
      "output": "weekly_digest",
      "config": "沿用原大事记支路",
      "description": "按时间汇总校园大事记并保留来源，不参与问卷主题和情绪占比统计。"
    },
    {
      "id": "16",
      "title": "结果汇总与排版",
      "type": "文本处理",
      "x": 2590,
      "y": 550,
      "input": "四路分析结果",
      "output": "report_markdown",
      "config": "词云 / 情绪 / 问题 / 大事记",
      "description": "等待四路结果完成，按模板组合图文内容。"
    },
    {
      "id": "17",
      "title": "结束",
      "type": "结束",
      "x": 3000,
      "y": 550,
      "input": "report_markdown",
      "output": "output",
      "config": "返回完整展示结果",
      "description": "返回整合后的内容，对应原图结束节点的多路输出。"
    }
  ],
